    },
    "Der iCloud-Account ist erreichbar, und es lag keine Änderung zum Abgleich an." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iCloud-Account ist erreichbar, und es lag keine Änderung zum Abgleich an."
