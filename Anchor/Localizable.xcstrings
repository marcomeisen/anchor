    },
    "Der iCloud-Account ist gerade nicht verfügbar. Das legt sich meist von selbst." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iCloud-Account ist gerade nicht verfügbar. Das legt sich meist von selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iCloud account is unavailable right now. This usually resolves itself."
          }
        }
      }
    },
    "Der iCloud-Container konnte nicht geöffnet werden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iCloud-Container konnte nicht geöffnet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iCloud container couldn’t be opened."
          }
        }
      }
    },
    "Der iCloud-Sync ist in den Einstellungen abgeschaltet. Änderungen bleiben lokal und werden nicht auf andere Geräte übertragen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iCloud-Sync ist in den Einstellungen abgeschaltet. Änderungen bleiben lokal und werden nicht auf andere Geräte übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sync is turned off in Settings. Changes stay local and aren’t sent to other devices."
          }
        }
      }
    },
    "Der Schalter überträgt keine Löschung: bereits in iCloud gespeicherte Daten bleiben dort. Zum Entfernen die vollständige Löschung unter Daten und Datenschutz nutzen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schalter überträgt keine Löschung: bereits in iCloud gespeicherte Daten bleiben dort. Zum Entfernen die vollständige Löschung unter Daten und Datenschutz nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This switch doesn’t delete anything: data already stored in iCloud stays there. To remove it, use the full deletion under Data & Privacy."
          }
        }
      }
    },
    "Der Sync endet beim nächsten Start von Anchorit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sync endet beim nächsten Start von Anchorit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync stops the next time Anchorit starts."
          }
        }
      }
    },
    "Der Sync startet beim nächsten Start von Anchorit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sync startet beim nächsten Start von Anchorit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync starts the next time Anchorit starts."
          }
        }
      }
    },
    "Der Zugriff lässt sich in den Systemeinstellungen unter Datenschutz → Erinnerungen erlauben. Anchorit liest nur und ändert dort nichts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff lässt sich in den Systemeinstellungen unter Datenschutz → Erinnerungen erlauben. Anchorit liest nur und ändert dort nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can allow access in System Settings under Privacy → Reminders. Anchorit only reads and changes nothing there."
          }
        }
      }
    },
    "Derselbe Store wird zweimal im Prozess mit CloudKit verbunden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derselbe Store wird zweimal im Prozess mit CloudKit verbunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same store is connected to CloudKit twice in this process."
          }
        }
      }
    },
    "Die Änderung ist lokal gespeichert, aber CloudKit hat seit zwei Minuten keinen Export gemeldet. Das kann an fehlender Netzwerkverbindung liegen; sonst in den Systemeinstellungen die iCloud-Anmeldung prüfen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderung ist lokal gespeichert, aber CloudKit hat seit zwei Minuten keinen Export gemeldet. Das kann an fehlender Netzwerkverbindung liegen; sonst in den Systemeinstellungen die iCloud-Anmeldung prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The change is saved locally, but CloudKit hasn’t reported an export for two minutes. This may be a missing network connection; otherwise check your iCloud sign-in in System Settings."
          }
        }
      }
    },
    "Die App zu löschen reicht dafür nicht: Deine Daten bleiben dann in iCloud liegen und werden bei einer Neuinstallation wiederhergestellt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App zu löschen reicht dafür nicht: Deine Daten bleiben dann in iCloud liegen und werden bei einer Neuinstallation wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting the app isn’t enough: your data stays in iCloud and comes back if you reinstall."
          }
        }
      }
    },
    "Die Daten in iCloud wurden gelöscht." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten in iCloud wurden gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The data in iCloud was deleted."
          }
        }
      }
    },
    "Die Daten konnten nicht gelöscht werden. Es wurde nichts entfernt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten konnten nicht gelöscht werden. Es wurde nichts entfernt."
