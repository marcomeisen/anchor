    "Der iCloud-Account ließ sich nicht abfragen. Ob etwas zu übertragen ist, ist deshalb unbekannt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der iCloud-Account ließ sich nicht abfragen. Ob etwas zu übertragen ist, ist deshalb unbekannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iCloud account could not be checked, so it is unknown whether anything needs to sync."
          }
        }
      }
    },
    "Richte Anchorit zuerst im Fenster ein — dort entscheidest du auch, ob iCloud synchronisiert." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte Anchorit zuerst im Fenster ein — dort entscheidest du auch, ob iCloud synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up Anchorit in its window first — that is also where you decide whether iCloud syncs."
          }
        }
      }
    },
    "iCloud-Account nicht erreichbar" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Account nicht erreichbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud account unreachable"
          }
        }
      }
    },
    "%@, %@, %@ und %@ werden auf diesem Gerät dauerhaft gelöscht. Ist iCloud verfügbar, wird auch der gesamte iCloud-Bestand gelöscht. Sichere vorher einen Export, wenn du deine Planung behalten möchtest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@, %@ und %@ werden auf diesem Gerät dauerhaft gelöscht. Ist iCloud verfügbar, wird auch der gesamte iCloud-Bestand gelöscht. Sichere vorher einen Export, wenn du deine Planung behalten möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@, %3$@ and %4$@ will be permanently deleted from this device. If iCloud is available, all of your iCloud data will be deleted too. Export first if you want to keep your planning."
          }
        }
      }
    },
