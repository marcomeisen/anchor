          "stringUnit" : {
            "state" : "translated",
            "value" : "Anchorit konnte die letzte Änderung nicht auf diesem Gerät sichern. Sie geht verloren, wenn die App beendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anchorit couldn’t save the last change on this device. It will be lost when the app quits."
          }
        }
