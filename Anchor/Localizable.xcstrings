    "Wochen, Anker, Aufgaben, Zeitblöcke, Tagesfokus und Notizen — also nur das, was du selbst eingibst. Es gibt keine Analyse, keine Werbung und keine Weitergabe an Dritte." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochen, Anker, Aufgaben, Zeitblöcke, Tagesfokus und Notizen — also nur das, was du selbst eingibst. Es gibt keine Analyse, keine Werbung und keine Weitergabe an Dritte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weeks, anchors, tasks, time blocks, daily focus and notes — only what you enter yourself. No analytics, no ads, nothing shared with third parties."
          }
        }
