    "Die Zahlen sind ein Hinweis. Die Antwort gibst du." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zahlen sind ein Hinweis. Die Antwort gibst du."
