    "Bis zu vier Anker, jeder mit einem Satz, warum. Aufgaben hängst du daran — oder lässt sie ohne." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu vier Anker, jeder mit einem Satz, warum. Aufgaben hängst du daran — oder lässt sie ohne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to four anchors, each with one sentence on why. Tasks hang on them — or stand without one."
          }
        }
      }
    },
    "Bis zu vier. Mehr geht nicht — das ist der Punkt." : {
      "localizations" : {
