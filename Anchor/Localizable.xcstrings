    "%@ Auch die Daten in iCloud sind entfernt; deine anderen Geräte leeren sich beim nächsten Abgleich." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Auch die Daten in iCloud sind entfernt; deine anderen Geräte leeren sich beim nächsten Abgleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ The data in iCloud is gone too; your other devices will clear at their next sync."
          }
        }
      }
    },
    "%@ Dieses Gerät ist nicht bei iCloud angemeldet. Liegen dort noch Daten, lösche sie von einem angemeldeten Gerät aus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Dieses Gerät ist nicht bei iCloud angemeldet. Liegen dort noch Daten, lösche sie von einem angemeldeten Gerät aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ This device isn’t signed in to iCloud. If data remains there, delete it from a signed-in device."
          }
        }
      }
    },
    "%@ Losgelassene Aufgaben lassen sich nicht wiederherstellen." : {
