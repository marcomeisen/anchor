<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Rückfallsprache für Systeme ohne passende Übersetzung. Die Texte stehen auf Deutsch
	     im Katalog (Quellsprache), aber wer weder Deutsch noch Englisch eingestellt hat,
	     bekommt Englisch statt Deutsch. Siehe `AppLanguage`. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Deutsch ist die Quellsprache und hat deshalb keine eigene Stringtabelle — ohne diese
	     Angabe wüsste das System nicht, dass die App Deutsch kann, und gäbe deutschen Nutzern
	     Englisch. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
	</array>
	<!-- Export-Compliance vorab beantwortet, sonst bleibt jeder TestFlight-Upload in App Store
	     Connect bis zur Antwort haengen. `false`: ausser HTTPS/CloudKit keine Verschluesselung,
	     Apples Standardverschluesselung faellt unter die Ausnahme. Kaeme eigene Kryptografie
	     dazu, muesste der Wert auf `true` und eine Einstufung hinterlegt werden. -->
	<!-- Einmaliger Import aus Apple Erinnerungen (Einstellungen → Daten). Nur lesen, nur auf
	     Wunsch. Englisch steht in InfoPlist.xcstrings. Seit iOS 17 / macOS 14 verlangt
	     `requestFullAccessToReminders` genau diesen Schlüssel. -->
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Anchorit liest deine offenen Erinnerungen nur, wenn du sie importierst, und übernimmt sie als Aufgaben. In Apple Erinnerungen wird nichts geändert.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Deep Links: anchorit://today, //week/2026-08-03, //day/2026-08-05,
	     //goal/<UUID>, //year, //review. Ohne diese Registrierung liefert das
	     System die URL nicht an die App aus. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.marcomeisen.Anchor.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anchorit</string>
				<!-- Alter Produktname: vorhandene Links und Kurzbefehle sollen weiter funktionieren. -->
				<string>daivento</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
